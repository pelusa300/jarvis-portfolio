# Jarvis — Central credentials
# Copy to ~/.config/jarvis/.env and fill in your values (chmod 600)

# Anthropic API (used by scout, job-hunter, cfo, plu)
ANTHROPIC_API_KEY=

# Telegram Bot (shared group)
TELEGRAM_GROUP_ID=
TELEGRAM_CHAT_ID=

# Telegram Thread IDs (topic IDs inside the Jarvis supergroup)
TELEGRAM_THREAD_HERRAMIENTAS=   # "Herramientas Jarvis" topic — health-check alerts
TELEGRAM_THREAD_FINANZAS=       # "Finanzas" topic — CFO reports
TELEGRAM_THREAD_JOB_HUNTER=     # "Job Hunter" topic — job alerts
