<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.adrianjobhunter</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/your_username/Mis-Agentes/agente-job-hunter/main.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/your_username/Mis-Agentes/agente-job-hunter</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>2</integer>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/your_username/Mis-Agentes/agente-job-hunter/logs/job_hunter.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/your_username/Mis-Agentes/agente-job-hunter/logs/job_hunter.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
